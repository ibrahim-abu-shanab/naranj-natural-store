DATABASE_URL=postgresql://naranj:CHANGE_ME@localhost:5432/naranj
DIRECT_DATABASE_URL=postgresql://naranj:CHANGE_ME@localhost:5432/naranj
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enables read-only sample catalog; must be false in production.
DEMO_MODE=true
# local requires a persistent volume. Use s3 for Vercel.
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=
# Neon Object Storage may instead inject AWS_ENDPOINT_URL_S3, AWS_REGION,
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY. These remain server-only.
# Optional Search Console verification token, never a placeholder in production.
GOOGLE_SITE_VERIFICATION=
# Reserved for a future consent-controlled GA4 integration. No tracking runs yet.
# Leave blank until a real measurement ID and consent policy are available.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
